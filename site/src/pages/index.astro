---
import '../styles/theme.css';
import mark from '../assets/mark.svg?raw';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}install/`;
const repo = 'https://github.com/ayagmar/runnerd';
const title = 'runnerd: GitHub Actions runners on your own Linux machine';
const description =
  'runnerd runs GitHub Actions jobs on a Linux machine you already have: a fresh container per job, Docker inside it without --privileged, every runner inside one memory budget.';
const url = new URL(base, Astro.site).href;
const install = 'curl -fsSL https://github.com/ayagmar/runnerd/releases/latest/download/install.sh | sh';

// examples/runnerd.toml, in GiB: two trellis runners, two glowly runners and the Docker Hub mirror in ci.slice.
const example = { max: 33, trellis: { memory: 9, slots: 2 }, glowly: { memory: 7, slots: 2 }, mirror: 0.5 };
const blocks = [
  ...Array.from({ length: example.trellis.slots }, () => ({ kind: 'trellis', size: example.trellis.memory })),
  ...Array.from({ length: example.glowly.slots }, () => ({ kind: 'glowly', size: example.glowly.memory })),
  { kind: 'mirror', size: example.mirror },
];
const used = blocks.reduce((sum, block) => sum + block.size, 0);

// A real `runnerd doctor` run on a host whose slice has no unit file yet; the format is crates/daemon/src/doctor.rs.
const doctorOk = [
  'ok    Docker: reachable, Docker 29.9.2',
  'ok    cgroups: cgroup v2 with the systemd driver',
  'info  isolation: sysbox: runners run unprivileged',
  "ok    sysbox: Docker has the sysbox-runc runtime and sysbox's services run",
];
const doctorFail = `FAIL  slice: demo.slice has no unit file with a MemoryMax, so nothing holds runners to the budget
      fix: create /etc/systemd/system/demo.slice with
           [Slice]
           MemoryMax=32.5G
           then: sudo systemctl daemon-reload`;
const doctorRest = [
  'ok    config: valid, with warnings: the slice demo.slice has no MemoryMax, so nothing holds runners to their 32.5G of caps; install a unit file for it',
  'ok    gh: logged in to github.com with the repo scope',
  'info  /dev/kvm: present, for a future Kata Containers backend',
];

// One slot over two jobs: the container is new each time, the slot's cache layer is kept.
const steps = [
  {
    container: 'new',
    label: 'new container',
    title: 'Runner starts',
    text: "runnerd registers a just-in-time runner and starts a new container in a free slot, over the slot's cache layer.",
  },
  {
    container: 'job',
    label: 'job',
    title: 'Job runs',
    text: "The runner takes one queued job. Its Docker builds and Testcontainers run in the container's own Docker Engine.",
  },
  {
    container: 'gone',
    label: 'removed',
    title: 'Container removed',
    text: 'The runner unregisters, the container exits and runnerd removes it. The layer keeps its Docker images, ~/.cache and the tool cache.',
  },
  {
    container: 'new',
    label: 'new container',
    title: 'Next job',
    text: 'The next job gets a new container over the same layer: warm caches, nothing else left from the last job.',
  },
];

const today = [
  ['The scheduler', 'runnerd serve polls GitHub for queued jobs and starts a just-in-time runner for each one, from one pool shared by every configured repository, while the slice has room.'],
  ['Warm caches', 'a read-only snapshot per profile with a writable layer per slot, a shared pnpm store and Maven repository, and a Docker Hub mirror.'],
  ['The daemon API', 'JSON on a Unix socket only your user can open: status, pause and resume a repository, shut down.'],
  ['runnerd check-config and doctor', 'the budget sum and the host checks above.'],
  ['The runner image', 'the GitHub Actions runner with its own Docker Engine, one stage per profile.'],
  ['Isolation', 'sysbox by default; privileged Docker-in-Docker only with allow_unsafe.'],
  ['Releases', 'x86_64 and aarch64 Linux builds with SHA-256 checksums and build provenance attestations.'],
];
const next = [
  ['Job history', 'a timeline, timings, metrics and logs for every job.'],
  ['Live events', 'server-sent events from the daemon as runners start and jobs finish.'],
  ['runnerctl', 'the command-line client for the daemon API.'],
  ['The dashboard', 'a web view served by the daemon on a loopback port.'],
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="runnerd" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Same key as Starlight's theme picker, so the landing page and the docs agree.
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav wrap">
      <a class="wordmark" href={base}><span class="mark" set:html={mark} />runnerd</a>
      <nav aria-label="Main">
        <a href={docs}>Docs</a>
        <a href="#install">Install</a>
        <a href={repo}>GitHub</a>
        <button class="theme" type="button" aria-label="Switch to light theme" data-theme-toggle>
          <span aria-hidden="true">Light</span>
        </button>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="title">
        <h1 id="title">CI runners that fit the machine</h1>
        <div class="hero-copy">
          <p class="lead">
            runnerd runs your GitHub Actions jobs on a Linux machine you already have. Every job gets a fresh
            container with its own Docker, and every runner stays inside one systemd memory budget.
          </p>
          <div class="hero-side">
            <p class="status">
              It is in early development: the daemon schedules runners and serves a small JSON API; job history,
              metrics, the CLI client and the web dashboard come next.
            </p>
            <div class="actions">
              <a class="button" href="#install">Install</a>
              <a class="text-link" href={docs}>Read the docs</a>
            </div>
          </div>
        </div>

        <figure class="budget budget-hero" data-ui>
          <div
            class="bar"
            role="img"
            aria-label={`Memory budget of ci.slice: two trellis runners at 9G, two glowly runners at 7G and a 512M Docker Hub mirror, ${used}G of ${example.max}G.`}
          >
            <div class="slice" style="--share: 1"></div>
            <div class="blocks">
              {
                blocks.map((block, i) => (
                  <div class={`block ${block.kind}`} style={`--size: ${block.size}; --i: ${i}`}>
                    {block.kind !== 'mirror' && (
                      <>
                        <span class="size">{block.size}G</span>
                        <span class="name">{block.kind}</span>
                      </>
                    )}
                  </div>
                ))
              }
              <div class="free" style={`--size: ${example.max - used}`}></div>
            </div>
          </div>
          <figcaption>
            <span>ci.slice, MemoryMax=33G</span>
            <span>Two trellis runners, two glowly runners, and a 512M sliver for the Docker Hub mirror: 32.5G.</span>
          </figcaption>
        </figure>
      </section>

      <section class="calc wrap" id="budget" aria-labelledby="budget-title">
        <div class="calc-text">
          <h2 id="budget-title">Check the budget before a job runs</h2>
          <p>
            Give each runner profile a memory cap and a number of slots. runnerd adds up slots × memory over every
            profile, plus the Docker Hub mirror, and refuses a config that does not fit the slice's
            <code>MemoryMax</code>. systemd holds the slice to that limit, so runners cannot take memory the rest of
            the machine needs.
          </p>
          <form class="controls" data-calc hidden>
            <fieldset>
              <legend>The slice</legend>
              <label>
                <span>MemoryMax</span>
                <input type="range" name="max" min="8" max="64" step="1" value={example.max} />
                <output data-for="max">{example.max}G</output>
              </label>
            </fieldset>
            <fieldset class="trellis">
              <legend>trellis profile</legend>
              <label>
                <span>memory</span>
                <input type="range" name="trellis-memory" min="1" max="16" step="0.5" value={example.trellis.memory} />
                <output data-for="trellis-memory">{example.trellis.memory}G</output>
              </label>
              <label>
                <span>slots</span>
                <input type="range" name="trellis-slots" min="1" max="6" step="1" value={example.trellis.slots} />
                <output data-for="trellis-slots">{example.trellis.slots}</output>
              </label>
            </fieldset>
            <fieldset class="glowly">
              <legend>glowly profile</legend>
              <label>
                <span>memory</span>
                <input type="range" name="glowly-memory" min="1" max="16" step="0.5" value={example.glowly.memory} />
                <output data-for="glowly-memory">{example.glowly.memory}G</output>
              </label>
              <label>
                <span>slots</span>
                <input type="range" name="glowly-slots" min="1" max="6" step="1" value={example.glowly.slots} />
                <output data-for="glowly-slots">{example.glowly.slots}</output>
              </label>
            </fieldset>
            <label class="toggle">
              <input type="checkbox" name="mirror" checked />
              <span>Docker Hub mirror, 512M</span>
            </label>
          </form>
        </div>

        <div class="calc-result" data-ui>
          <div class="bar bar-small" aria-hidden="true" data-calc-bar>
            <div class="slice" style="--share: 1"></div>
            <div class="blocks">
              {blocks.map((block) => <div class={`block ${block.kind}`} style={`--size: ${block.size}`} />)}
              <div class="free" style={`--size: ${example.max - used}`}></div>
            </div>
          </div>
          <pre class="terminal"><code><span class="prompt">$ runnerd check-config runnerd.toml --memory-max <span data-out="max">33G</span></span>
<span data-out="result" class="ok" aria-live="polite">runnerd.toml: valid, memory caps sum to 32.5G</span></code></pre>
        </div>
      </section>

      <section class="slots wrap" aria-labelledby="slots-title">
        <div class="slots-head">
          <h2 id="slots-title">A fresh container for every job</h2>
          <p>
            A slot is one concurrent job of a profile. Its container lives for one job; its cache layer stays, so the
            next job starts new but warm. Here is one trellis slot over two jobs.
          </p>
        </div>
        <ol class="slot-steps">
          {
            steps.map((step) => (
              <li>
                <div class={`slot ${step.container}`} aria-hidden="true">
                  <div class="slot-container">{step.label}</div>
                  <div class="slot-layer">slot layer</div>
                </div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="isolation">
          <div>
            <h3>Docker inside, no --privileged</h3>
            <p>
              Sysbox gives every runner container its own Docker Engine, so <code>docker build</code> and
              Testcontainers work while the container stays unprivileged.
            </p>
          </div>
          <div>
            <h3>Privileged only when you say so</h3>
            <p>
              <code>isolation = "unsafe-dind"</code> runs privileged containers, which a job can use to take over the
              host. runnerd refuses it unless <code>[host]</code> also sets <code>allow_unsafe = true</code>.
            </p>
          </div>
        </div>
      </section>

      <section class="doctor wrap" id="doctor" aria-labelledby="doctor-title">
        <div class="doctor-text">
          <h2 id="doctor-title">runnerd doctor names the fix</h2>
          <p>
            It checks Docker, cgroups, sysbox, the slice, your config and the GitHub CLI in the order a new machine
            needs them, and every failure says how to fix it. This host is ready except for its slice.
          </p>
        </div>
        <pre class="terminal transcript" data-ui><code><span class="prompt">$ runnerd doctor runnerd.toml</span>
{doctorOk.join('\n')}
<span class="fail">{doctorFail}</span>{doctorRest.join('\n')}</code></pre>
      </section>

      <section class="roadmap wrap" aria-labelledby="roadmap-title">
        <h2 id="roadmap-title">What works today, and what comes next</h2>
        <div class="sheet">
          <div class="column today">
            <h3>In 0.0.x today</h3>
            <ul>
              {
                today.map(([name, text]) => (
                  <li>
                    <strong>{name}</strong>: {text}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="column next">
            <h3>Being built</h3>
            <ul>
              {
                next.map(([name, text]) => (
                  <li>
                    <strong>{name}</strong>: {text}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="install wrap" id="install" aria-labelledby="install-title">
        <div class="install-tile">
          <h2 id="install-title">Install in one line</h2>
          <p>
            The script downloads <code>runnerd</code> and <code>runnerctl</code> from the latest release, checks their
            SHA-256, copies them to <code>~/.local/bin</code> and runs <code>runnerd doctor</code>. It never uses sudo.
          </p>
          <div class="command">
            <pre><code>{install}</code></pre>
            <button class="copy" type="button" data-copy={install} hidden>Copy</button>
          </div>
          <p>
            Then, from a checkout of the repository, build the image stages your profiles use and start the daemon
            with
            <code>runnerd serve --config runnerd.toml</code>.
          </p>
          <p class="install-links">
            <a href={docs}>Install guide and requirements</a>
            <a href={`${base}running/`}>Running the daemon</a>
            <a href={`${docs}#verify-a-release`}>Verify a release</a>
          </p>
        </div>
      </section>
    </main>

    <footer class="footer wrap">
      <div class="mark-large" aria-hidden="true">
        {['r', 'u', 'n', 'n', 'e', 'r', 'd'].map((letter, i) => <span style={`--i: ${i}`}>{letter}</span>)}
      </div>
      <div class="footer-row">
        <nav aria-label="Footer">
          <a href={docs}>Install</a>
          <a href={`${base}configuration/`}>Configuration</a>
          <a href={`${base}running/`}>Running</a>
          <a href={repo}>Source</a>
          <a href={`${repo}/releases`}>Releases</a>
        </nav>
        <p>runnerd is MIT licensed. Linux hosts and GitHub repositories only, for now.</p>
      </div>
    </footer>

    <script>
      import { setup } from '../scripts/landing';
      setup();
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--ink);
    color-scheme: dark;
    -webkit-text-size-adjust: 100%;
  }

  html[data-theme='light'] {
    color-scheme: light;
  }

  body {
    margin: 0;
    font-family: var(--font-text);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.55;
    overflow-x: clip;
  }

  :root {
    --gutter: clamp(1rem, 3.2vw, 3rem);
    --gap: 8px;
    --step-small: 0.875rem;
    --step-lead: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    --step-head: clamp(2rem, 1.3rem + 3.2vw, 4rem);
    --step-display: clamp(2.75rem, 0.9rem + 7vw, 8.5rem);
    --section: clamp(6rem, 4rem + 8vw, 12rem);
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .wrap {
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    margin: 0;
    text-wrap: balance;
  }

  h2 {
    font-size: var(--step-head);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0;
    max-width: 62ch;
  }

  a {
    color: inherit;
    text-underline-offset: 0.18em;
  }

  code,
  pre {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace;
  }

  p code,
  li code,
  label code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.08em 0.3em;
  }

  .skip {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 0.75rem 1rem;
    font-family: var(--font-display);
    z-index: 10;
  }

  .skip:focus {
    top: 0.5rem;
  }

  /* Navigation: wordmark, three links, the theme switch. */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    font-family: var(--font-display);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .mark svg {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
  }

  .nav nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 1.75rem);
  }

  .nav nav a,
  .theme {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }

  .nav nav a:hover {
    text-decoration: underline;
  }

  .theme {
    font-family: inherit;
    color: inherit;
    background: var(--surface);
    border: 0;
    cursor: pointer;
    padding-inline: 0.85rem;
  }

  .theme:hover {
    background: var(--surface-2);
  }

  html:not(.js) .theme {
    display: none;
  }

  /* Hero: the title, then the budget bar as the one large shape. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 4.5vh, 3.5rem) clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-top: clamp(2rem, 6vh, 5rem);
  }

  .hero .budget {
    grid-column: 1 / -1;
  }

  .hero h1 {
    font-size: var(--step-display);
    line-height: 0.92;
    letter-spacing: -0.045em;
    max-width: 12.5ch;
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 0.4rem;
  }

  .lead {
    font-size: clamp(1.1875rem, 1rem + 0.55vw, 1.4375rem);
    line-height: 1.45;
    max-width: 40ch;
  }

  .hero-side {
    display: grid;
    gap: 1.5rem;
  }

  .status {
    color: var(--muted);
    font-size: 1rem;
    max-width: 44ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    font-family: var(--font-display);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 1.75rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    transition: transform 160ms var(--ease), background-color 160ms;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button:active {
    transform: translateY(1px);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* The budget bar: the slice is the ground, each runner slot a block sized by its memory cap. */
  .bar {
    position: relative;
    height: clamp(9rem, 32vh, 22rem);
  }

  .bar .slice {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--share) * 100%);
    background: var(--surface);
    transition: width 300ms var(--ease);
  }

  .bar .blocks {
    position: relative;
    display: flex;
    gap: var(--gap);
    height: 100%;
  }

  .block,
  .free {
    flex: var(--size) 1 0;
    min-width: 0;
  }

  .block {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(0.5rem, 1.4vw, 1.25rem);
    color: var(--block-ink);
    font-family: var(--font-display);
    overflow: hidden;
    transition: flex-grow 300ms var(--ease), background-color 200ms;
  }

  .block.trellis {
    background: var(--mint);
  }

  .block.glowly {
    background: var(--pink);
  }

  .block.mirror {
    background: var(--ink);
    flex-basis: 3px;
  }

  .block .size {
    font-size: clamp(1.75rem, 0.6rem + 4.6vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .block .name {
    font-size: clamp(0.8125rem, 0.7rem + 0.4vw, 1.0625rem);
    font-weight: 600;
    margin-top: 0.4rem;
  }

  .budget {
    margin: 0;
  }

  .budget figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-top: 0.85rem;
    font-family: var(--font-display);
    font-size: var(--step-small);
    color: var(--muted);
  }

  .budget figcaption span:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  /* The calculator. */
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 6rem);
    padding-top: var(--section);
    align-items: start;
  }

  .calc-text {
    display: grid;
    gap: 1.5rem;
  }

  .controls {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.5rem;
    font-family: var(--font-display);
  }

  .controls fieldset {
    min-width: 0;
    margin: 0;
    padding: 1rem 1.25rem 0.5rem;
    border: 0;
    background: var(--surface);
  }

  .controls fieldset.trellis {
    box-shadow: inset 6px 0 0 var(--mint);
  }

  .controls fieldset.glowly {
    box-shadow: inset 6px 0 0 var(--pink);
  }

  .controls legend {
    padding: 0;
    font-weight: 700;
    font-size: 1rem;
  }

  .controls label {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
