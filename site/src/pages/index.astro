---
import { Font } from 'astro:assets';
import '../styles/theme.css';
import mark from '../assets/mark.svg?raw';
import Overview from '../components/Overview.astro';
import Tui from '../components/Tui.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}install/`;
const repo = 'https://github.com/ayagmar/runnerd';
const title = 'runnerd: GitHub Actions runners on your own Linux machine';
const description =
  'runnerd runs GitHub Actions jobs on a Linux machine you already have: a fresh container per job, Docker inside it without --privileged, every runner inside one memory budget.';
const url = new URL(base, Astro.site).href;
const card = new URL(`${base}og.png`, Astro.site).href;
const install = 'curl -fsSL https://github.com/ayagmar/runnerd/releases/latest/download/install.sh | sh';
const firstRun = ['runnerd init halyard/ledger halyard/storefront', 'systemctl --user enable --now runnerd'];

// The calculator's starting config, the example on every page: two jvm and two node slots and the Docker Hub mirror,
// in GiB, inside ci.slice.
const example = {
  max: 33,
  profiles: [
    { kind: 'jvm', memory: 9, slots: 2 },
    { kind: 'node', memory: 7, slots: 2 },
  ],
  mirror: 0.5,
};
const blocks = [
  ...example.profiles.flatMap((p) => Array.from({ length: p.slots }, () => ({ kind: p.kind, size: p.memory }))),
  { kind: 'mirror', size: example.mirror },
];
const used = blocks.reduce((sum, block) => sum + block.size, 0);

// runnerd doctor's output as 0.0.5 prints it for that setup, the lines as doctor.rs formats them: the config names
// demo.slice, which has no unit file yet, and the jvm and node images, not pulled yet.
const doctorOk = [
  'ok    Docker: reachable, Docker 29.9.2',
  'ok    cgroups: cgroup v2 with the systemd driver',
  'info  isolation: sysbox: runners run unprivileged',
  "ok    sysbox: Docker has the sysbox-runc runtime and sysbox's services run",
];
const doctorFail = `FAIL  slice: demo.slice has no unit file with a MemoryMax, so nothing holds runners to the budget
      fix: create /etc/systemd/system/demo.slice with
           [Slice]
           MemoryMax=32.5G
           then: sudo systemctl daemon-reload`;
const doctorRest = [
  'ok    config: valid, with warnings: the slice demo.slice has no MemoryMax, so nothing holds runners to their 32.5G of caps; install a unit file for it',
  'ok    image: ghcr.io/ayagmar/runnerd-runner:jvm-0.0.5: not pulled yet; runnerd pulls it before the first runner',
  'ok    image: ghcr.io/ayagmar/runnerd-runner:node-0.0.5: not pulled yet; runnerd pulls it before the first runner',
  'ok    gh: logged in to github.com with the repo scope',
  'info  /dev/kvm: present, for a future Kata Containers backend',
];
const unsafe =
  'error: isolation "unsafe-dind" runs runner containers privileged, so a job can take over the host; set allow_unsafe = true under [host] to use it anyway';

// One jvm slot over two jobs: the container is new each time, the slot's layer stays.
const steps = [
  { container: 'new', label: 'new container', text: 'A just-in-time runner, over the slot layer.' },
  { container: 'job', label: 'job', text: 'Its own Docker Engine, unprivileged.' },
  { container: 'gone', label: 'removed', text: 'The layer keeps images and ~/.cache.' },
  { container: 'new', label: 'next job', text: 'Nothing left over but warm caches.' },
];

// Real output of runnerctl from main, against the web dashboard's demo daemon (crates/web/examples/demo).
const pauseRefused = `error: halyard/ledger runs job 120055991700 on runnerd-3f9a-forge-jvm-1-1792708105; pause with force to cancel it
\`runnerctl pause --force halyard/ledger\` cancels its runs and removes their runners`;

// The clients, each a slot: filled once released, with a link to it; free until it ships with real output.
const clientsDoc = `${base}clients/`;
const clients = [
  { name: 'runnerctl', state: 'In 0.0.2', href: `${clientsDoc}#runnerctl` },
  { name: 'Web dashboard', state: 'In 0.0.2', href: `${clientsDoc}#dashboard` },
  { name: 'TUI', state: 'In 0.0.3', href: `${clientsDoc}#runnerctl-tui` },
  { name: 'Desktop app', state: 'Coming' },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="runnerd" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <Font cssVariable="--font-text" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-display" preload />
    <script is:inline>
      // Same key as Starlight's theme picker, so the landing page and the docs agree.
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav wrap">
      <a class="wordmark" href={base}><span class="mark" set:html={mark} />runnerd</a>
      <nav aria-label="Main">
        <a href={docs}>Docs</a>
        <a href="#install">Install</a>
        <a href={repo}>GitHub</a>
        <button class="theme" type="button" aria-label="Switch to light theme" data-theme-toggle>
          <span aria-hidden="true">Light</span>
        </button>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="title">
        <h1 id="title">CI runners that <br />fit the machine</h1>
        <div class="hero-copy">
          <p class="lead">
            GitHub Actions jobs on a Linux machine you already have. A fresh container per job, every runner inside
            one memory budget.
          </p>
          <div class="actions">
            <a class="button" href="#install">Install</a>
            <a class="text-link" href={docs}>Read the docs</a>
          </div>
        </div>

        <figure class="hero-live">
          <figcaption class="prompt-line"><code>$ runnerctl web</code></figcaption>
          <Overview />
        </figure>
      </section>

      <section class="live wrap" id="live" aria-label="runnerctl">
        <figure class="live-tui">
          <figcaption class="prompt-line"><code>$ runnerctl tui</code></figcaption>
          <Tui
            name="overview"
            label="runnerctl tui's overview at 136 by 28: the budget bar with jvm slot 1 at 4.3G and node slot 1 at 2.7G used, four slot cards, the slice's memory and CPU charts, the repositories and the latest jobs."
          />
        </figure>
        <div class="live-pause">
          <pre class="terminal transcript"><code><span class="prompt">$ runnerctl pause halyard/ledger</span>
<span class="fail">{pauseRefused}</span></code></pre>
          <a class="text-link" href={clientsDoc}>Dashboard and CLI</a>
        </div>
      </section>

      <section class="calc wrap" id="budget" aria-labelledby="budget-title">
        <div class="calc-text">
          <h2 id="budget-title">It adds up before it runs</h2>
          <p>Slots × memory, plus the mirror, must fit the slice.</p>
          <form class="config" data-calc hidden>
            <fieldset class="jvm">
              <legend>[profiles.jvm]</legend>
              <label>
                <span>memory =</span>
                <input type="range" name="jvm-memory" min="1" max="16" step="0.5" value="9" />
                <output data-for="jvm-memory">"9G"</output>
              </label>
              <label>
                <span>slots =</span>
                <input type="range" name="jvm-slots" min="1" max="6" step="1" value="2" />
                <output data-for="jvm-slots">2</output>
              </label>
            </fieldset>
            <fieldset class="node">
              <legend>[profiles.node]</legend>
              <label>
                <span>memory =</span>
                <input type="range" name="node-memory" min="1" max="16" step="0.5" value="7" />
                <output data-for="node-memory">"7G"</output>
              </label>
              <label>
                <span>slots =</span>
                <input type="range" name="node-slots" min="1" max="6" step="1" value="2" />
                <output data-for="node-slots">2</output>
              </label>
            </fieldset>
            <fieldset>
              <legend>[caches]</legend>
              <label class="toggle">
                <input type="checkbox" name="mirror" checked />
                <span>mirror, 512M</span>
              </label>
            </fieldset>
            <fieldset>
              <legend>ci.slice</legend>
              <label>
                <span>MemoryMax=</span>
                <input type="range" name="max" min="8" max="64" step="1" value={example.max} />
                <output data-for="max">{example.max}G</output>
              </label>
            </fieldset>
          </form>
        </div>

        <div class="calc-result">
          <div class="bar bar-small" aria-hidden="true" data-calc-bar>
            <div class="slice" style="--share: 1"></div>
            <div class="blocks">
              {blocks.map((block) => <div class={`block ${block.kind}`} style={`--size: ${block.size}`} />)}
              <div class="free" style={`--size: ${example.max - used}`}></div>
            </div>
          </div>
          <pre class="terminal"><code><span class="prompt">$ runnerd check-config runnerd.toml --memory-max <span data-out="max">33G</span></span>
<span data-out="result" class="ok" aria-live="polite">runnerd.toml: valid, memory caps sum to 32.5G</span></code></pre>
        </div>
      </section>

      <section class="slots wrap" aria-labelledby="slots-title">
        <h2 id="slots-title">One slot, two jobs</h2>
        <ol class="slot-steps">
          {
            steps.map((step) => (
              <li>
                <div class={`slot ${step.container}`} aria-hidden="true">
                  <div class="slot-container">{step.label}</div>
                  <div class="slot-layer">jvm slot layer</div>
                </div>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="checks wrap" id="doctor" aria-labelledby="doctor-title">
        <h2 id="doctor-title">Every failure names its fix</h2>
        <div class="check-runs">
          <div class="doctor-run">
            <pre class="terminal transcript"><code><span class="prompt">$ runnerd doctor runnerd.toml | grep -A4 FAIL</span>
<span class="fail">{doctorFail}</span></code></pre>
            <details>
              <summary>The whole run: ten checks</summary>
              <pre class="terminal transcript"><code><span class="prompt">$ runnerd doctor runnerd.toml</span>
{doctorOk.join('\n')}
<span class="fail">{doctorFail}</span>{doctorRest.join('\n')}</code></pre>
            </details>
          </div>
          <div class="unsafe">
            <h3>Privileged only when you say so</h3>
            <pre class="terminal transcript"><code><span class="prompt"># [host] isolation = "unsafe-dind"
$ runnerd check-config runnerd.toml</span>
<span class="fail">{unsafe}</span></code></pre>
          </div>
        </div>
      </section>

      <section class="roadmap wrap" aria-labelledby="roadmap-title">
        <h2 id="roadmap-title">One slot still free</h2>
        <ul class="strip">
          <li class="shipped">
            <strong>runnerd 0.0.5</strong>
            <span>Released</span>
          </li>
          {
            clients.map((client) =>
              client.href ? (
                <li class="shipped">
                  <a href={client.href}>
                    <strong>{client.name}</strong>
                    <span>{client.state}</span>
                  </a>
                </li>
              ) : (
                <li>
                  <strong>{client.name}</strong>
                  <span>{client.state}</span>
                </li>
              ),
            )
          }
        </ul>
        <p class="shipped-list">
          History, metrics, live events and controls on a JSON API, with the CLI, the TUI and the dashboard.
        </p>
      </section>

      <section class="install wrap" id="install" aria-labelledby="install-title">
        <div class="install-tile">
          <h2 id="install-title">Install</h2>
          <div class="commands">
            <div class="command">
              <pre><code>{install}</code></pre>
              <button class="copy" type="button" data-copy={install} hidden>Copy</button>
            </div>
            <div class="command">
              <pre class="lines"><code>{firstRun.map((line) => <span>{line}</span>)}</code></pre>
            </div>
          </div>
          <p>No sudo. <code>init</code> prints the root steps it needs and runs none.</p>
          <p class="install-links">
            <a href={`${docs}#first-run`}>First run</a>
            <a href={`${base}running/#the-service`}>The service</a>
            <a href={`${docs}#verify-a-release`}>Verify a release</a>
          </p>
        </div>
      </section>
    </main>

    <footer class="footer wrap">
      <div class="mark-large" aria-hidden="true">
        {['r', 'u', 'n', 'n', 'e', 'r', 'd'].map((letter, i) => <span style={`--i: ${i}`}>{letter}</span>)}
      </div>
      <div class="footer-row">
        <nav aria-label="Footer">
          <a href={docs}>Install</a>
          <a href={`${base}configuration/`}>Configuration</a>
          <a href={`${base}running/`}>Running</a>
          <a href={repo}>Source</a>
          <a href={`${repo}/releases`}>Releases</a>
        </nav>
        <p>
          MIT licensed. Linux hosts and GitHub repositories, for now. Terminal frames in JetBrains Mono
          (<a href={`${base}fonts/JetBrainsMono-OFL.txt`}>OFL</a>).
        </p>
      </div>
    </footer>

    <script>
      import { setup } from '../scripts/landing';
      setup();
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--ink);
    color-scheme: dark;
    -webkit-text-size-adjust: 100%;
  }

  html[data-theme='light'] {
    color-scheme: light;
  }

  body {
    margin: 0;
    font-family: var(--font-text);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.55;
    overflow-x: clip;
  }

  :root {
    --gutter: clamp(1rem, 3.2vw, 3rem);
    --gap: 8px;
    --step-small: 0.875rem;
    --step-lead: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    --step-head: clamp(2rem, 1.3rem + 3.2vw, 4rem);
    --step-display: clamp(2.6rem, 0.9rem + 5.4vw, 6.5rem);
    --section: clamp(6rem, 4rem + 8vw, 12rem);
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .wrap {
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    margin: 0;
    text-wrap: balance;
  }

  h2 {
    font-size: var(--step-head);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0;
    max-width: 62ch;
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-underline-offset: 0.18em;
  }

  code,
  pre {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace;
  }

  p code,
  li code,
  label code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.08em 0.3em;
  }

  .skip {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 0.75rem 1rem;
    font-family: var(--font-display);
    z-index: 10;
  }

  .skip:focus {
    top: 0.5rem;
  }

  /* Navigation: wordmark, three links, the theme switch. */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    font-family: var(--font-display);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .mark svg {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
  }

  .nav nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 1.75rem);
  }

  .nav nav a,
  .theme {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }

  .nav nav a:hover {
    text-decoration: underline;
  }

  .theme {
    font-family: inherit;
    color: inherit;
    background: var(--surface);
    border: 0;
    cursor: pointer;
    padding-inline: 0.85rem;
  }

  .theme:hover {
    background: var(--surface-2);
  }

  html:not(.js) .theme {
    display: none;
  }

  /* Hero: the title, then the dashboard's overview replaying as the one large shape. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 4.5vh, 3.5rem) clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-top: clamp(2rem, 6vh, 5rem);
  }

  .hero-live {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .hero h1 {
    font-size: var(--step-display);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 0.4rem;
  }

  .lead {
    font-size: clamp(1.1875rem, 1rem + 0.55vw, 1.4375rem);
    line-height: 1.45;
    max-width: 36ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    font-family: var(--font-display);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 1.75rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    transition: transform 160ms var(--ease), background-color 160ms;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button:active {
    transform: translateY(1px);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* The budget bar: the slice is the ground, each runner slot a block sized by its memory cap. */
  .bar {
    position: relative;
    height: clamp(11rem, 44vh, 30rem);
  }

  .bar .slice {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--share) * 100%);
    background: var(--surface);
    transition: width 300ms var(--ease);
  }

  .bar .blocks {
    position: relative;
    display: flex;
    gap: var(--gap);
    height: 100%;
  }

  .block,
  .free {
    flex: var(--size) 1 0;
    min-width: 0;
  }

  .block {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(0.5rem, 1.4vw, 1.25rem);
    color: var(--block-ink);
    font-family: var(--font-display);
    overflow: hidden;
    transition: flex-grow 300ms var(--ease), background-color 200ms;
  }

  .block.jvm {
    background: var(--mint);
  }

  .block.node {
    background: var(--pink);
  }

  .block.mirror {
    background: var(--ink);
    flex-basis: 3px;
  }

  /* The terminal clients: a frame of the TUI, then runnerctl's real output. */
  .live {
    padding-top: var(--section);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* Each client under the command that opens it. */
  .prompt-line code {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .live-pause {
    display: grid;
    max-width: 62rem;
    gap: 1rem;
    justify-items: start;
  }

  .live-pause pre {
    width: 100%;
  }

  .live-tui {
    display: grid;
    gap: 1rem;
    margin: 0;
  }


  /* The calculator. */
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 6rem);
    padding-top: var(--section);
    align-items: start;
  }

  .calc-text {
    display: grid;
    gap: 1.5rem;
  }

  /* The calculator's controls are the config itself: the profile tables, the mirror, the slice's limit. */
  .config {
    display: grid;
    gap: var(--gap);
    margin-top: 0.5rem;
  }

  .config fieldset {
    min-width: 0;
    margin: 0;
    padding: 0.85rem 1.25rem 0.35rem;
    border: 0;
    background: var(--surface);
  }

  .config fieldset.jvm {
    box-shadow: inset 6px 0 0 var(--mint);
  }

  .config fieldset.node {
    box-shadow: inset 6px 0 0 var(--pink);
  }

  .config legend,
  .config label span,
  .config output {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 0.9375rem;
  }

  .config legend {
    padding: 0;
    float: left;
    width: 100%;
    font-weight: 700;
  }

  .config label {
    clear: both;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 3.75rem;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
  }

  .config output {
    text-align: right;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .config input[type='range'] {
    width: 100%;
    height: 44px;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .config .toggle {
    grid-template-columns: auto 1fr;
    cursor: pointer;
  }

  .config .toggle input {
    width: 1.375rem;
    height: 1.375rem;
    margin: 0;
    accent-color: var(--accent);
  }

  .calc-result {
    display: grid;
    gap: var(--gap);
    position: sticky;
    top: 1.5rem;
  }

  .bar-small {
    height: clamp(8rem, 34vh, 20rem);
  }

