---
import { Font } from 'astro:assets';
import '../styles/theme.css';
import '../styles/landing.css';
import mark from '../assets/mark.svg?raw';
import Shot from '../components/Shot.astro';
import Tui from '../components/Tui.astro';
import replay from '../assets/admission/replay.json';
import { printed } from '../lib/printed';
import { size } from '../lib/units';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}start/install/`;
const repo = 'https://github.com/ayagmar/runnerd';
const version = '0.1.0';
const title = 'runnerd: GitHub Actions runners on your own Linux machine';
const description =
  'runnerd runs GitHub Actions jobs on a Linux machine you already have, a fresh container per job. With measured admission each runner reserves what its job really peaks at, so more jobs fit in the same memory.';
const url = new URL(base, Astro.site).href;
const card = new URL(`${base}og.png`, Astro.site).href;

// The same 33G under both admission policies, from one fictional 28-day history (assets/admission/replay.json):
// `runnerd simulate`'s rows, and each job's runs, p95 peak and what measured admission reserves for it once it has
// `min_jobs` runs, its p95 plus the default 15% margin rounded up to 256M. The lanes are one burst of that history at
// its busiest: 3 jvm and 5 node jobs queued together, of which caps start the first 2 of each profile and the rest
// wait for memory. A lane per job, in the order they queued; each lane's block is its share of the 33G, as on the
// dashboard's overview.
const GIB = 1024 ** 3;
const max = 33;
const mirror = 0.5;
const caps = { jvm: 9, node: 7 };
const job = (key: string) => {
  const found = replay.jobs[key as keyof typeof replay.jobs];
  return { ...found, kind: found.profile as 'jvm' | 'node', name: found.job.replace(/^CI \/ /, '') };
};
const integration = job('halyard/ledger integration tests');
const ledger = job('halyard/ledger build');
const storefront = job('halyard/storefront build');
const e2e = job('halyard/storefront e2e');
const queued = [integration, ledger, ledger, storefront, storefront, storefront, storefront, e2e];
// Which of them caps start: the first two of each profile.
const started = queued.map((j, i) => queued.slice(0, i).filter((k) => k.kind === j.kind).length < 2);

// simulate's numbers are right-aligned under their headings; the two each lane's figure quotes come from its own row.
const [simulateHead, ...simulateRows] = replay.table;
const cell = (policy: string, column: string) => {
  const row = simulateRows.find((r) => r.startsWith(`${policy} `));
  const end = simulateHead!.indexOf(column) + column.length;
  const value = row?.slice(0, end).split(' ').at(-1);
  if (!value) throw new Error(`no ${column} for ${policy} in replay.json`);
  return value;
};
const policies = (['caps', 'measured'] as const).map((policy) => {
  const sizes = queued.map((j, i) => (policy === 'caps' ? (started[i] ? caps[j.kind] : 0) : j.reserve / GIB));
  const offsets = sizes.map((_, i) => sizes.slice(0, i).reduce((sum, s) => sum + s, 0));
  const reserved = sizes.reduce((sum, s) => sum + s, 0);
  const atOnce = sizes.filter((s) => s > 0).length;
  if (atOnce !== Number(cell(policy, 'AT ONCE'))) throw new Error(`${policy}: ${atOnce} lanes run, simulate says otherwise`);
  return {
    policy, sizes, offsets, reserved, atOnce,
    p95: cell(policy, 'WAIT P95'), longest: cell(policy, 'WAIT MAX'),
    free: max - reserved - mirror,
  };
});
const [byCaps, byPeaks] = policies;
const pct = (gib: number) => `${((gib / max) * 100).toFixed(3)}%`;
// A lane's style: where its block starts and how wide it is under each policy.
const lane = (at: number, width: (p: (typeof policies)[number]) => number) =>
  policies.map((p) => `--at-${p.policy}: ${pct(at === -1 ? p.reserved : p.offsets[at]!)}; --w-${p.policy}: ${pct(width(p))}`).join('; ');
// A waiting job's reason, in the words runnerd uses for it (api::Waiting::Memory).
const waits = (j: (typeof queued)[number]) => `Needs ${size(caps[j.kind] * GIB)} of memory; ${size(byCaps!.free * GIB)} of the budget is free`;

// The quick start, from the install page.
const install = 'curl -fsSL https://github.com/ayagmar/runnerd/releases/latest/download/install.sh | sh';
const init = `runnerd init halyard/ledger halyard/storefront
systemctl --user daemon-reload
systemctl --user enable --now runnerd`;
const runsOn = 'runs-on: [self-hosted, linux, x64]';

// What runnerctl printed against the dashboard's demo daemon; each block cuts out the lines it shows and changes none.
const status = `$ runnerctl status\n${printed('status', 'JOB ')}`;
const caches = `$ runnerctl caches\n${printed('caches', 'build cache for')}`;
const savings = printed('insights', 'This month', '  ');
const shell = `$ runnerctl shell 120055991489
runnerd: the record of job 120055991489 of halyard/ledger, CI / build
It failed at step 6: Unit tests (exit code 1)
Its log shows it ran:
    ./gradlew test --no-daemon
    shell: /usr/bin/bash -e {0}
You are in /home/runner/_work/ledger/ledger, as the job left it. [...] Exit to remove this container.
runner@4be1c0d2a7e9:~/_work/ledger/ledger$`;

const compared = [
  ['Runs on', 'a Linux machine you run', "GitHub's machines", 'your Kubernetes cluster', 'a machine you run'],
  ['Each job gets', 'a new container; its slot keeps the caches', 'a new VM', 'a new pod', 'what the last job left, unless the runner is ephemeral'],
  ['Memory per job', "its profile's cap, or with measured admission what the job peaks at", 'the runner size you pay for', "the pod's requests and limits", 'the whole machine, one job at a time'],
  ['You run', 'one daemon, Docker and Sysbox', 'nothing', 'Kubernetes and the controller', 'one runner service per concurrent job'],
  ['Minutes cost', 'your machine', 'billed past your plan on private repositories', 'your cluster', 'your machine'],
];
// runnerd's column first, so a phone shows it before the table scrolls.
const sides = ['runnerd', 'GitHub-hosted', 'Actions Runner Controller', 'A self-hosted runner'];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="runnerd" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <Font cssVariable="--font-display" preload />
    <script is:inline>
      // Same key as Starlight's theme picker, so the landing page and the docs agree.
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav wrap">
      <a class="wordmark" href={base}><span class="mark" set:html={mark} />runnerd</a>
      <nav aria-label="Main">
        <a href={docs}>Docs</a>
        <a href={repo}>GitHub</a>
        <button class="theme" type="button" aria-label="Switch to light theme" data-theme-toggle>Light</button>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="title">
        <div class="hero-text">
          <h1 id="title">Twice the runners in the same&nbsp;33G</h1>
          <p class="lead">runnerd runs your GitHub Actions jobs on a Linux machine you already have, each in a fresh container. With <code>admission = "measured"</code>, each runner reserves what its job really peaks at, not a fixed cap.</p>
          <div class="actions">
            <a class="button" href="#install">Set it up</a>
            <a class="text-link" href={docs}>Read the docs</a>
          </div>
        </div>

        <figure class="lanes" data-ui>
          <div class="switch" role="radiogroup" aria-label="How runners reserve memory">
            {policies.map((p) => (
              <label>
                <input type="radio" name="policy" value={p.policy} checked={p.policy === 'measured'} />
                <span>{p.policy === 'caps' ? 'Fixed caps' : 'Measured peaks'}</span>
              </label>
            ))}
          </div>
          {policies.map((p) => (
            <p class={`lanes-figure only-${p.policy}`}><strong>{p.atOnce} jobs</strong> at once; waits p95 {p.p95}, longest {p.longest}</p>
          ))}
          <ol class="lane-list" aria-label="The 33G slice, a lane per job">
            {queued.map((j, i) => (
              <li class={`lane ${j.kind}`} style={lane(i, (p) => p.sizes[i]!)}>
                <span class="track" aria-hidden="true"><span class="block" /></span>
                <span class="lane-name">{j.name}<span class="repo">{j.repository}</span></span>
                <span class="lane-size only-measured">{size(j.reserve)}</span>
                {started[i] ? (
                  <span class="lane-size only-caps">{size(caps[j.kind] * GIB)}</span>
                ) : (
                  <span class="lane-wait only-caps">{waits(j)}</span>
                )}
              </li>
            ))}
            <li class="lane mirror" style={lane(-1, () => mirror)}>
              <span class="track" aria-hidden="true"><span class="block" /></span>
              <span class="lane-name">mirror</span>
              <span class="lane-size">{size(mirror * GIB)}</span>
            </li>
            <li class="lane free" style={policies.map((p) => `--at-${p.policy}: ${pct(p.reserved + mirror)}; --w-${p.policy}: ${pct(p.free)}`).join('; ')}>
              <span class="track" aria-hidden="true"><span class="block" /></span>
              <span class="lane-name">free</span>
              {policies.map((p) => <span class={`lane-size only-${p.policy}`}>{size(p.free * GIB)}</span>)}
            </li>
          </ol>
          <figcaption>
            <span>A demo's 28-day history replayed by <code>runnerd simulate</code>, at its busiest: 3 jvm and 5 node jobs queued together.</span>
            <a class="text-link" href={`${base}guides/simulate/`}>Replay your own history</a>
          </figcaption>
        </figure>
      </section>

      <section class="part wrap split" aria-labelledby="attention-title">
        <div class="part-text">
          <h2 id="attention-title">What needs you comes&nbsp;first</h2>
          <p>A job no runner here can take, a doctor warning, a token GitHub refuses: the dashboard and the TUI open on them, each with what clears it.</p>
        </div>
        <Shot
          name="part-attention"
          alt="Four things that need attention on the overview: a config file other users can read, a public repository, a job no profile serves, and a test that got slower, each with its fix or where to look."
          sizes="(min-width: 960px) 40rem, calc(100vw - 2.5rem)"
        />
      </section>

      <section class="part wrap split" aria-labelledby="failure-title">
        <div class="part-text">
          <h2 id="failure-title">A failed job opens on&nbsp;why</h2>
          <p>The failing step, its exit code and its last lines, then the log folded by step. With <code>record_failures</code> on, <code>runnerctl shell</code> opens a failed job's container as the job left it.</p>
          <a class="text-link" href={`${base}guides/logs/`}>Why did this job fail?</a>
        </div>
        <div class="stack">
          <Shot
            name="part-failure"
            alt="A failed job's summary: step 5, Run ./gradlew test, failed with exit code 1, with the log lines that failed it."
            sizes="(min-width: 960px) 40rem, calc(100vw - 2.5rem)"
          />
          <p class="aside">Another failed job, <code>CI / build</code> of halyard/ledger, whose record was kept:</p>
          <pre class="terminal" tabindex="0" aria-label="runnerctl shell into the record of another failed job"><code>{shell}</code></pre>
        </div>
      </section>

      <section class="part wrap" aria-labelledby="waits-title">
        <div class="part-text">
          <h2 id="waits-title">Every wait says why</h2>
          <p>A queued job names what holds it. The timeline shows what each slot ran all day, the wait before each job.</p>
        </div>
        <div class="pair">
          <div><pre class="terminal wide" tabindex="0" aria-label="runnerctl status: the queue"><code>{status}</code></pre></div>
          <Shot
            name="part-timeline"
            alt="The slots' timeline over 24 hours: a lane per slot, each job a mark coloured by outcome, waits for a runner drawn before them."
            sizes="(min-width: 960px) 30rem, calc(100vw - 2.5rem)"
          />
        </div>
      </section>

      <section class="part wrap split" aria-labelledby="actions-title">
        <div class="part-text">
          <h2 id="actions-title">Cancel and re-run, shown before&nbsp;sent</h2>
          <p>GitHub cancels runs, not jobs. runnerd shows what a cancel or a re-run would touch, and sends nothing until you confirm.</p>
          <a class="text-link" href={`${base}guides/cancel-rerun/`}>Cancel and re-run</a>
        </div>
        <Shot
          name="part-cancel"
          alt="Cancel run 40018663900 (attempt 1) of halyard/ledger? GitHub cancels the whole run, here and on any other runner. Buttons: Cancel run, Keep it."
          sizes="(min-width: 960px) 40rem, calc(100vw - 2.5rem)"
        />
      </section>

      <section class="part wrap" aria-labelledby="clients-title">
        <div class="part-text">
          <h2 id="clients-title">On a phone, over SSH, in a script</h2>
          <p>The dashboard installs as an app on a phone, <code>runnerctl tui</code> works over SSH, and <code>runnerctl</code> prints the same figures for scripts.</p>
        </div>
        <div class="clients">
          <Tui
            name="overview-96"
            label="runnerctl tui's overview: the health line, what needs attention, a row per slot with its job, waiting jobs with why each waits, the repositories and the latest jobs."
          />
          <div class="phone">
            <Shot
              name="screen"
              phone
              alt="The dashboard's overview on a phone, one screen: the health figures, what needs attention, the budget and the tab bar."
              sizes="20rem"
            />
          </div>
        </div>
      </section>

      <section class="part wrap split" aria-labelledby="cache-title">
        <div class="part-text">
          <h2 id="cache-title">GitHub's cache, on your own&nbsp;disk</h2>
          <p><code>actions/cache</code>, the <code>cache:</code> input of <code>setup-node</code> and <code>setup-java</code>, and Docker's <code>type=gha</code> restore from and save to this machine, with no change to a workflow.</p>
          <a class="text-link" href={`${base}guides/caches/`}>The caches</a>
        </div>
        <pre class="terminal" tabindex="0" aria-label="runnerctl caches: the build cache's hits and what serves GitHub's cache"><code>{caches}</code></pre>
      </section>

      <section class="part wrap" aria-labelledby="compare-title">
        <div class="part-text">
          <h2 id="compare-title">Beside the other ways to run a&nbsp;job</h2>
        </div>
        <div class="compare-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
          <table class="compare">
            <thead>
              <tr>
                <td></td>
                {sides.map((side) => <th scope="col">{side}</th>)}
              </tr>
            </thead>
            <tbody>
              {compared.map(([row, ...cells]) => (
                <tr>
                  <th scope="row">{row}</th>
                  {cells.map((c, i) => <td data-side={sides[i]}>{c}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="savings">The dashboard prices what ran here at GitHub's rates. Its demo says: <code>{savings}</code></p>
      </section>

      <section class="part wrap" id="install" aria-labelledby="install-title">
        <h2 id="install-title">Running in three steps</h2>
        <div class="needs">
          <p>It needs Linux with systemd and cgroup v2, Docker with the systemd cgroup driver, <a href="https://github.com/nestybox/sysbox">Sysbox</a>, and the GitHub CLI logged in. Each job runs in a new container under Sysbox, with its own unprivileged Docker Engine, and the container is removed when the job ends. Serve private repositories only.</p>
          <a class="text-link" href={`${base}security/`}>Security model</a>
        </div>
        <ol class="steps">
          <li>
            <div>
              <h3>Install</h3>
              <p>A static binary for Linux, into <code>~/.local/bin</code>.</p>
            </div>
            <div class="command">
              <pre class="terminal" tabindex="0"><code>{install}</code></pre>
              <button class="copy" type="button" data-copy={install} hidden>Copy</button>
            </div>
          </li>
          <li>
            <div>
              <h3>Point it at your repositories</h3>
              <p><code>init</code> sizes the slots, writes the config and the service, and prints any root commands.</p>
            </div>
            <div class="command">
              <pre class="terminal" tabindex="0"><code>{init}</code></pre>
              <button class="copy" type="button" data-copy={init} hidden>Copy</button>
            </div>
          </li>
          <li>
            <div>
              <h3>Send jobs to it</h3>
              <p>In each workflow that should run here.</p>
            </div>
            <div class="command">
              <pre class="terminal" tabindex="0"><code>{runsOn}</code></pre>
              <button class="copy" type="button" data-copy={runsOn} hidden>Copy</button>
            </div>
          </li>
        </ol>
      </section>
    </main>

    <footer class="footer wrap">
      <a class="wordmark" href={base}><span class="mark" set:html={mark} />runnerd</a>
      <p>runnerd {version}, MIT licensed. Linux and GitHub Actions only.</p>
      <nav aria-label="Footer">
        <a href={docs}>Docs</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases`}>Releases</a>
      </nav>
    </footer>

    <script>
      import { setup } from '../scripts/landing';
      setup();
    </script>
  </body>
</html>
