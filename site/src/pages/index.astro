---
import { Font } from 'astro:assets';
import '../styles/theme.css';
import '../styles/landing.css';
import mark from '../assets/mark.svg?raw';
import Shot from '../components/Shot.astro';
import Tui from '../components/Tui.astro';
import replay from '../assets/admission/replay.json';
import { size } from '../scripts/overview';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}install/`;
const repo = 'https://github.com/ayagmar/runnerd';
const version = '0.0.26';
const title = 'runnerd: GitHub Actions runners on your own Linux machine';
const description =
  'runnerd runs GitHub Actions jobs on a Linux machine you already have: a fresh container per job, as many at once as its memory holds.';
const url = new URL(base, Astro.site).href;
const card = new URL(`${base}og.png`, Astro.site).href;

// The same 33G under both admission policies, from one fictional 28-day history (assets/admission/replay.json):
// `runnerd simulate`'s rows, and each job's runs, p95 peak and what measured admission reserves for it once it has
// `min_jobs` runs, its p95 plus the default 15% margin rounded up to 256M. The bars are one burst of that history
// at its busiest: 3 jvm and 5 node jobs queued together, of which caps start the first 2 of each profile.
const GIB = 1024 ** 3;
const max = 33;
const mirror = 0.5;
const caps = { jvm: 9, node: 7 };
const job = (key: string) => {
  const found = replay.jobs[key as keyof typeof replay.jobs];
  return { ...found, kind: found.profile as 'jvm' | 'node', name: found.job.replace(/^CI \/ /, '') };
};
const integration = job('halyard/ledger integration tests');
const ledger = job('halyard/ledger build');
const storefront = job('halyard/storefront build');
const e2e = job('halyard/storefront e2e');

// simulate's numbers are right-aligned under their headings; the two each row leads with come from its own row.
const [simulateHead, ...simulateRows] = replay.table;
const cell = (policy: string, column: string) => {
  const row = simulateRows.find((r) => r.startsWith(`${policy} `));
  const end = simulateHead!.indexOf(column) + column.length;
  const value = row?.slice(0, end).split(' ').at(-1);
  if (!value) throw new Error(`no ${column} for ${policy} in replay.json`);
  return value;
};
const packs = [
  { policy: 'caps', runners: [integration, ledger, storefront, storefront].map((j) => ({ ...j, size: caps[j.kind] })) },
  {
    policy: 'measured',
    runners: [integration, ledger, ledger, storefront, storefront, storefront, storefront, e2e].map((j) => ({
      ...j,
      size: j.reserve / GIB,
    })),
  },
].map((pack) => {
  const reserved = pack.runners.reduce((sum, r) => sum + r.size, 0) + mirror;
  const atOnce = Number(cell(pack.policy, 'AT ONCE'));
  if (atOnce !== pack.runners.length) throw new Error(`${pack.policy}: ${pack.runners.length} blocks, simulate says ${atOnce}`);
  return { ...pack, free: max - reserved, atOnce, p95: cell(pack.policy, 'WAIT P95'), longest: cell(pack.policy, 'WAIT MAX') };
});

// What runnerctl printed against the dashboard's demo daemon (crates/web/examples/demo), kept whole in
// assets/terminal; each block below cuts out the lines it shows and changes none.
const printed = (name: string, ...heads: string[]) => {
  const files = import.meta.glob<string>('../assets/terminal/*.txt', { eager: true, query: '?raw', import: 'default' });
  const text = files[`../assets/terminal/${name}.txt`];
  if (text === undefined) throw new Error(`no capture ${name}`);
  const lines = text.trimEnd().split('\n');
  const from = (head: string) => {
    const at = lines.findIndex((line) => line.startsWith(head));
    if (at < 0) throw new Error(`no "${head}" in ${name}`);
    return at;
  };
  return lines.slice(from(heads[0]!), heads[1] === undefined ? undefined : from(heads[1])).join('\n').trimEnd();
};

// The queue of `runnerctl status`: storefront's jobs, and why each waits.
const waits = `$ runnerctl status\n${printed('status', 'JOB ')}`;

// The cache volumes' last two lines.
const caches = `$ runnerctl caches\n${printed('caches', 'build cache for')}`;

const shell = `$ runnerctl shell 120055991489
runnerd: the record of job 120055991489 of halyard/ledger, CI / build
It failed at step 5: Unit tests (exit code 1)
Its log shows it ran:
    ./gradlew test --no-daemon
    shell: /usr/bin/bash -e {0}
You are in /home/runner/_work/ledger/ledger, as the job left it. Exit to remove this container.
runner@4be1c0d2a7e9:~/_work/ledger/ledger$`;

// What the minutes would have cost, as runnerctl insights itemises it.
const costRows = `2,184 minutes of 412 jobs at actions_linux (2-core Linux, $0.006 a minute): $13.10
9 jobs free on GitHub: on a standard runner, of a public repository
5 jobs not priced: lost, so how long they ran is not known`;


// The quick start, from the install page.
const install = 'curl -fsSL https://github.com/ayagmar/runnerd/releases/latest/download/install.sh | sh';
const init = `runnerd init halyard/ledger halyard/storefront
systemctl --user daemon-reload
systemctl --user enable --now runnerd`;
const runsOn = 'runs-on: [self-hosted, linux, x64]';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="runnerd" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <Font cssVariable="--font-display" preload />
    <script is:inline>
      // Same key as Starlight's theme picker, so the landing page and the docs agree.
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav wrap">
      <a class="wordmark" href={base}><span class="mark" set:html={mark} />runnerd</a>
      <nav aria-label="Main">
        <a href={docs}>Docs</a>
        <a href={repo}>GitHub</a>
        <button class="theme" type="button" aria-label="Switch to light theme" data-theme-toggle>Light</button>
        <a class="button small" href="#install">Install</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="title">
        <div class="hero-text">
          <h1 id="title">CI runners on your own&nbsp;box</h1>
          <p class="lead">
            runnerd runs your GitHub Actions jobs on one Linux machine, each in a fresh container, as many at once as
            its memory holds.
          </p>
          <div class="actions">
            <a class="button" href="#install">Install</a>
            <a class="text-link" href={docs}>Read the docs</a>
          </div>
        </div>
        <div class="hero-shot">
          <Shot
            name="overview"
            eager
            alt="The runnerd dashboard: 2 of 6 slots running, 5 jobs waiting with why each waits, the memory and CPU reserved, the memory budget as blocks per slot, the slots with their jobs' memory and CPU, and the latest jobs."
            sizes="(min-width: 1100px) 60vw, calc(100vw - 2rem)"
          />
        </div>
      </section>

      <section class="part wrap split" id="admission" aria-labelledby="pack-title">
        <div class="part-text">
          <h2 id="pack-title">Twice the runners in the same&nbsp;33G</h2>
          <p>
            Each runner reserves what its job really peaks at, measured over its last 20 runs, instead of a fixed cap. A
            job that runs out of memory gets its full cap back.
          </p>
          <p>
            Runners share the CPUs by their <code>cpus</code>. A job's page says how often its cap held it back. Under
            measured admission, a job its cap holds back in 3 runs raises <code>cpus</code>.
          </p>
          <a class="text-link" href={`${base}admission/`}>How admission works</a>
        </div>
        <div class="packs">
          {packs.map((pack) => (
            <figure class={`pack pack-${pack.policy}`} data-ui>
              <p class="pack-figure">
                <strong>{pack.atOnce} jobs</strong> at once, longest wait {pack.longest}
              </p>
              <ul class="pack-bar" style={`--total: ${max}`} aria-label={`${pack.atOnce} runners in 33G`}>
                {pack.runners.map((runner) => (
                  <li class={`block ${runner.kind}`} style={`--size: ${runner.size}`}>
                    <span class="visually-hidden">{runner.repository} {runner.job}: </span>
                    {size(runner.size * GIB)}
                  </li>
                ))}
                <li class="block mirror" style={`--size: ${mirror}`}><span class="visually-hidden">mirror, 512M</span></li>
                <li class="free" style={`--size: ${pack.free}`}><span class="visually-hidden">{size(pack.free * GIB)} free</span></li>
              </ul>
              <figcaption>
                <span class="swatch jvm" />jvm <span class="swatch node" />node. The busiest moment of a replayed 28-day
                history: 3 jvm and 5 node jobs queued together.
              </figcaption>
            </figure>
          ))}
          <div class="switch" role="radiogroup" aria-label="How runners reserve memory">
            {packs.map((pack, i) => (
              <label>
                <input type="radio" name="policy" value={pack.policy} checked={i === 1} />
                <span>{pack.policy === 'caps' ? 'Fixed caps' : 'Measured peaks'}</span>
              </label>
            ))}
          </div>
        </div>
      </section>

      <section class="part wrap split stacked" id="waits" aria-labelledby="waits-title">
        <div class="part-text">
          <h2 id="waits-title">Every wait says why</h2>
          <p>
            A queued job names what holds it: busy slots, a runner still starting, a label nothing serves. A typo in <code>runs-on</code> shows up
            before you go looking for it. Time runnerd was not running is left out of the waits that sizing and
            insights count, so a night with the machine off does not read as a slow week.
          </p>
        </div>
        <div class="proof"><pre class="terminal wide" tabindex="0" data-ui aria-label="runnerctl status: the queue"><code>{waits}</code></pre></div>
      </section>

      <section class="part wrap split stacked" id="cache" aria-labelledby="cache-title">
        <div class="part-text">
          <h2 id="cache-title">GitHub's cache, on your own&nbsp;disk</h2>
          <p>
            <code>actions/cache</code>, the <code>cache:</code> input of <code>setup-node</code> and <code>setup-java</code>,
            and Docker's <code>type=gha</code> restore from and save to this machine, with no change to a workflow.
            A job that gets a new runner starts in the free slot that ran it last, when one is free, so it finds
            what that run left.
          </p>
          <p>It is on by default.</p>
          <a class="text-link" href={`${base}running/#build-cache`}>The build cache</a>
        </div>
        <div class="proof"><pre class="terminal" tabindex="0" data-ui aria-label="runnerctl caches: the build cache's hits and what serves GitHub's cache"><code>{caches}</code></pre></div>
      </section>

      <section class="part wrap split" id="records" aria-labelledby="shell-title">
        <div class="part-text">
          <h2 id="shell-title">A shell in the job that failed</h2>
          <p>
            With <code>record_failures = true</code>, a failed job's container is kept. <code>runnerctl shell</code> opens
            it at the step that failed, with its files as the job left them.
          </p>
          <a class="text-link" href={`${base}running/`}>Records of failed jobs</a>
        </div>
        <div class="proof"><pre class="terminal" tabindex="0" data-ui aria-label="runnerctl shell into a failed job"><code>{shell}</code></pre></div>
      </section>

      <section class="part wrap cost" id="cost" aria-labelledby="cost-title">
        <h2 id="cost-title">What GitHub would have charged</h2>
        <div class="cost-body">
          <p class="cost-figure"><strong>$13.10</strong> this month</p>
          <div>
            <p>
              runnerd prices each job at GitHub's per-minute rate, rounded up to the minute as GitHub bills, before your
              plan's free minutes. Public repositories on standard runners count as free.
            </p>
            <pre class="terminal" tabindex="0" data-ui aria-label="runnerctl insights: the cost estimate"><code>{costRows}</code></pre>
          </div>
        </div>
      </section>

      <section class="part wrap" id="clients" aria-labelledby="clients-title">
        <div class="part-text narrow">
          <h2 id="clients-title">Watch it from anywhere</h2>
          <p>
            A dashboard you can install as an app on your phone, a terminal UI, and <code>runnerctl</code> for scripts.
            All three read the same daemon.
          </p>
          <a class="text-link" href={`${base}clients/`}>The clients</a>
        </div>
        <div class="clients">
          <Tui
            name="overview-96"
            label="runnerctl tui's overview: 2 of 6 slots running, 5 jobs waiting with why each waits, the budget bar, one line per slot, the repositories and the latest jobs."
          />
          <Shot
            name="job"
            alt="A running job in the dashboard: its steps on one time axis, memory and CPU against what it reserved, and its latest runs."
            sizes="(min-width: 1100px) 45vw, calc(100vw - 2rem)"
          />
        </div>
      </section>

      <section class="part wrap" id="install" aria-labelledby="install-title">
        <h2 id="install-title">Running in three steps</h2>
        <ol class="steps">
          <li>
            <div>
              <h3>Install</h3>
              <p>A static binary for x86-64 Linux, into <code>~/.local/bin</code>.</p>
            </div>
            <div class="command">
              <pre class="terminal" tabindex="0" data-ui><code>{install}</code></pre>
              <button class="copy" type="button" data-copy={install} hidden>Copy</button>
            </div>
          </li>
          <li>
            <div>
              <h3>Point it at your repositories and start it</h3>
              <p>
                <code>init</code> sizes the slots so the first job can start, writes a config only you can read and the
                service, warns about a public repository, and prints any root commands to run before you start it.
              </p>
            </div>
            <div class="command">
              <pre class="terminal" tabindex="0" data-ui><code>{init}</code></pre>
              <button class="copy" type="button" data-copy={init} hidden>Copy</button>
            </div>
          </li>
          <li>
            <div>
              <h3>Send jobs to it</h3>
              <p>In each workflow that should run here.</p>
            </div>
            <div class="command">
              <pre class="terminal" tabindex="0" data-ui><code>{runsOn}</code></pre>
              <button class="copy" type="button" data-copy={runsOn} hidden>Copy</button>
            </div>
          </li>
        </ol>
        <a class="button" href={docs}>Read the install guide</a>
      </section>
    </main>

    <footer class="footer wrap">
      <a class="wordmark" href={base}><span class="mark" set:html={mark} />runnerd</a>
      <p>runnerd {version}, MIT licensed. Linux and GitHub Actions only.</p>
      <nav aria-label="Footer">
        <a href={docs}>Docs</a>
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases`}>Releases</a>
      </nav>
    </footer>

    <script>
      import { setup } from '../scripts/landing';
      import '../scripts/zoom';
      setup();
    </script>
  </body>
</html>
