---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import '../styles/theme.css';
import '../styles/landing.css';
import mark from '../assets/mark.svg?raw';
import Overview from '../components/Overview.astro';
import Shot from '../components/Shot.astro';
import Tui from '../components/Tui.astro';
import replay from '../assets/admission/replay.json';
import { size } from '../scripts/overview';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}install/`;
const clientsDoc = `${base}clients/`;
const repo = 'https://github.com/ayagmar/runnerd';
const version = '0.0.19';
const title = 'runnerd: GitHub Actions runners on your own Linux machine';
const description =
  'runnerd runs GitHub Actions jobs on a Linux machine you already have: a fresh container per job, Docker inside it without --privileged, every runner inside one memory budget.';
const url = new URL(base, Astro.site).href;
const card = new URL(`${base}og.png`, Astro.site).href;

const facts = [
  { term: 'A container per job', text: 'new each time, Docker inside, unprivileged', tone: 'mint' },
  { term: 'One memory budget', text: 'every runner inside one systemd slice', tone: 'pink' },
  { term: 'Nothing hosted', text: 'your machine and GitHub, no service between', tone: '' },
  { term: 'One daemon', text: 'on a Linux machine you already have', tone: 'base' },
];

// The same 33G under both admission policies, from one fictional 28-day history (assets/admission/replay.json):
// `runnerd simulate`'s rows, and each job's runs, p95 peak and what measured admission reserves for it once it has
// `min_jobs` runs, its p95 plus the default 15% margin rounded up to 256M. The bars are one burst of that history
// at its busiest: 3 jvm and 5 node jobs queued together, of which caps start the first 2 of each profile.
const GIB = 1024 ** 3;
const max = 33;
const mirror = 0.5;
const caps = { jvm: 9, node: 7 };
const job = (key: string) => {
  const found = replay.jobs[key as keyof typeof replay.jobs];
  return { ...found, kind: found.profile as 'jvm' | 'node', name: found.job.replace(/^CI \/ /, '') };
};
const integration = job('halyard/ledger integration tests');
const ledger = job('halyard/ledger build');
const storefront = job('halyard/storefront build');
const e2e = job('halyard/storefront e2e');

// simulate's numbers are right-aligned under their headings; the two each row leads with come from its own row.
const [simulateHead, ...simulateRows] = replay.table;
const cell = (policy: string, column: string) => {
  const row = simulateRows.find((r) => r.startsWith(`${policy} `));
  const end = simulateHead!.indexOf(column) + column.length;
  const value = row?.slice(0, end).split(' ').at(-1);
  if (!value) throw new Error(`no ${column} for ${policy} in replay.json`);
  return value;
};
const packs = [
  { policy: 'caps', runners: [integration, ledger, storefront, storefront].map((j) => ({ ...j, size: caps[j.kind] })) },
  {
    policy: 'measured',
    runners: [integration, ledger, ledger, storefront, storefront, storefront, storefront, e2e].map((j) => ({
      ...j,
      size: j.reserve / GIB,
    })),
  },
].map((pack) => {
  const reserved = pack.runners.reduce((sum, r) => sum + r.size, 0) + mirror;
  const atOnce = Number(cell(pack.policy, 'AT ONCE'));
  if (atOnce !== pack.runners.length) throw new Error(`${pack.policy}: ${pack.runners.length} blocks, simulate says ${atOnce}`);
  return { ...pack, free: max - reserved, atOnce, p95: cell(pack.policy, 'WAIT P95'), longest: cell(pack.policy, 'WAIT MAX') };
});
const simulateMeasured = simulateRows.at(-1);

// runnerctl against the web dashboard's demo daemon (crates/web/examples/demo): a running job's head, with what
// admission reserved under its caps, and storefront served in two profiles, with its queue and why each job waits.
const jobHead = `CI / build  running  job 120055991700
halyard/ledger · main · run 40018663900
https://github.com/halyard/ledger/actions/runs/40018663900/job/120055991700
runner runnerd-3f9a-forge-jvm-1-1792896193 (profile jvm, slot 1, capped at 9G and 8 CPUs)
admitted by measured peaks: reserved 7.75G, the p95 peak of its job's last 20 runs + the margin; 17G of the budget was free, the slice at 6.25G. Reserved 3.6 CPUs, the p95 average of 212 runs of its job; 22 CPUs of the budget were free`;
const pools = `REPOSITORY          PROFILE  STATE   QUEUED  LABELS
halyard/ledger      jvm      active       0  self-hosted,linux,x64,jvm
halyard/storefront  node     active       4  self-hosted,linux,x64,node
                    small                 0  storefront-small

JOB           REPOSITORY                 WORKFLOW / NAME    QUEUED      WAITS FOR
120055991720  halyard/storefront         CI / lint          5m 23s ago  No profile serves the label storefornt-small
120055991710  halyard/storefront · node  E2E / visual-diff  1m 14s ago  A runner is starting for it in node 2
120055991711  halyard/storefront · node  E2E / a11y         1m 8s ago   All 2 node slots are busy
120055991712  halyard/storefront · node  E2E / lighthouse   55s ago     All 2 node slots are busy
120055991713  halyard/storefront · node  E2E / unit         42s ago     All 2 node slots are busy`;

// runnerctl sizing's node profile, as the clients page prints it.
const sizing = `node  7G × 2, 8 CPUs; 242 jobs, slots busy 78%, waited p50 12s p95 4m 20s
  warm runners took 31 of 40 jobs: waited p50 2s, the others 21s
  memory p50 1.4G p95 1.9G p99 2G max 2.1G
  cpu    p50 3.1 p95 6.9 p99 7.6 max 7.9`;
const sizingAdvice = `  lower memory to 3.25G from 7G, its largest peak + 1G for page cache; 4 slots fit in the same 14G`;

// The quick start, from the install page: its commands, and runnerd init's output there on a 62G, 32-CPU host
// with no slice yet. The doctor's passing checks between the two parts are left out.
const install = 'curl -fsSL https://github.com/ayagmar/runnerd/releases/latest/download/install.sh | sh';
const cargo = [
  'cargo install --locked runnerd runnerd-cli   # Rust 1.99 or later',
  'cargo binstall runnerd runnerd-cli           # the release archives',
];
const init = 'runnerd init halyard/ledger halyard/storefront';
const initWrote = `wrote ~/.config/runnerd/runnerd.toml: 5 slots of 8G and 6 CPUs in runnerd.slice (46.5G)
wrote ~/.config/systemd/user/runnerd.service`;
const initFail = `FAIL  slice: runnerd.slice has no unit file with a MemoryMax, so nothing holds runners to the budget
      fix: sudo tee /etc/systemd/system/runnerd.slice >/dev/null <<'EOF'
           [Slice]
           MemoryMax=46.5G
           EOF
           sudo systemctl daemon-reload`;
const start = ['systemctl --user daemon-reload', 'systemctl --user enable --now runnerd'];
const runsOn = 'runs-on: [self-hosted, linux, x64]';

// Isolation, from the configuration page: the one line init writes, and what a privileged profile is refused with.
const isolationToml = `[host]
slice = "runnerd.slice"
isolation = "sysbox"`;
const refuse = `$ runnerd check-config runnerd.toml
error: isolation "unsafe-dind" runs runner containers privileged, so a job can take over the host; set allow_unsafe = true under [host] to use it anyway`;

// A job's way through runnerd, from the lifecycle diagram on the running page.
const lifecycle = [
  { name: 'queued', what: 'GitHub lists it; its labels match' },
  { name: 'slot', what: "the profile's lowest free slot" },
  { name: 'JIT runner', what: 'registers for one job' },
  { name: 'container', what: 'slot volume over the snapshot' },
  { name: 'running', what: 'steps, log, samples every 2 s' },
  { name: 'finished', what: 'runner exits, scrubs its secrets' },
  { name: 'removed', what: 'container and runner; slot free' },
];

// Auto sizing, from the admission page.
const autoToml = `[sizing]
auto = true`;

// Records of failed jobs, from the running page: the profile key, and what runnerctl shell opens.
const recordToml = `[profiles.jvm]
memory = "9G"
slots = 2
record_failures = true`;
const shell = `$ runnerctl shell 120055991489
runnerd: the record of job 120055991489 of halyard/ledger, CI / build
It failed at step 5: Unit tests (exit code 1)
Its log shows it ran:
    ./gradlew test --no-daemon
    shell: /usr/bin/bash -e {0}
You are in /home/runner/_work/ledger/ledger, as the job left it. Exit to remove this container.
runner@4be1c0d2a7e9:~/_work/ledger/ledger$`;

// What the minutes would have cost, from the insights page: the headline `runnerctl insights` opens with and the
// lines under it.
const costHead = `This month: 2,184 job-minutes here, an estimated $13.10 at GitHub's 2-core Linux rate, before your plan's free minutes, by today's profiles and repository visibility (14 jobs not priced)`;
const costRows = `  2,184 minutes of 412 jobs at actions_linux (2-core Linux, $0.006 a minute): $13.10
  9 jobs free on GitHub: on a standard runner, of a public repository
  5 jobs not priced: lost, so how long they ran is not known`;

// The phone's capture, one <picture> per theme: the page is dark until its script runs, so the dark sources are the
// default and the light ones start disabled (media="not all"); the theme switch in scripts/landing.ts enables them.
// The images are lazy, so the light theme never loads the dark copy first. It links to its full-size dark file;
// scripts/zoom.ts opens it, or the light one in the light theme, in an overlay. The desktop captures use Shot.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/dashboard/*.webp', { eager: true });
const capture = async (name: string, widths: number[]) => {
  const themes = await Promise.all(
    (['light', 'dark'] as const).map(async (theme) => {
      const src = shots[`../assets/dashboard/${name}-${theme}.webp`]!.default;
      return Promise.all(
        (['avif', 'webp'] as const).map(async (format) => {
          const images = await Promise.all(widths.map((width) => getImage({ src, width, format, quality: 70 })));
          return { theme, type: `image/${format}`, srcset: images.map((i) => `${i.src} ${i.attributes.width}w`).join(', ') };
        }),
      );
    }),
  );
  const src = shots[`../assets/dashboard/${name}-dark.webp`]!.default;
  const light = shots[`../assets/dashboard/${name}-light.webp`]!.default;
  const fallback = await getImage({ src, width: widths[0], format: 'webp', quality: 70 });
  return { sources: themes.flat(), src, light, fallback };
};
const phoneShot = await capture('overview-phone', [390, 480, 640, 780]);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="runnerd" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={card} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <Font cssVariable="--font-text" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-display" preload />
    <script is:inline>
      // Same key as Starlight's theme picker, so the landing page and the docs agree.
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="board nav">
      <a class="tile wordmark-tile" href={base}>
        <span class="wordmark"><span class="mark" set:html={mark} />runnerd</span>
      </a>
      <nav class="nav-links" aria-label="Main" style="display: contents">
        <a class="tile tile-docs" href={docs}>Docs</a>
        <a class="tile tile-install" href="#install">Install</a>
        <a class="tile" href={repo}>GitHub</a>
      </nav>
      <div class="tile tile-theme">
        <button class="theme" type="button" aria-label="Switch to light theme" data-theme-toggle>
          <span aria-hidden="true">Light</span>
        </button>
      </div>
    </header>

    <main id="main">
      <section class="board hero" aria-labelledby="title">
        <div class="tile hero-text">
          <h1 id="title">CI runners that <br />fit the machine</h1>
          <div class="hero-copy" style="display: grid; gap: 1.5rem">
            <p class="lead">
              GitHub Actions jobs on a Linux machine you already have: a fresh container per job, every runner inside
              one memory budget.
            </p>
            <div class="actions">
              <a class="button" href="#install">Install</a>
              <a class="text-link" href={docs}>Read the docs</a>
            </div>
          </div>
        </div>
        <div class="tile hero-stage">
          <Overview />
        </div>
        {
          facts.map((fact) => (
            <div class={`tile fact ${fact.tone}`}>
              <strong>{fact.term}</strong>
              <span>{fact.text}</span>
            </div>
          ))
        }
      </section>

      <section class="board part" id="admission" aria-labelledby="pack-title">
        <div class="tile big-head mint">
          <h2 id="pack-title">Same 33G, twice the runners</h2>
        </div>
        {
          packs.map((pack) => (
            <>
              <div class={`tile pack-label ${pack.policy}`}>
                <span class="stat">{pack.atOnce}</span>
                <div>
                  <p class="unit">runners at once under <code>admission = "{pack.policy}"</code></p>
                  <p class="pack-waits">waits: p95 {pack.p95}, longest {pack.longest}</p>
                </div>
              </div>
              <ul class="tile pack-bar" style={`--total: ${max}`}>
                {pack.runners.map((runner, i) => (
                  <li class={`block ${runner.kind}`} style={`--size: ${runner.size}; --used: ${runner.p95 / GIB / runner.size}; --i: ${i}`}>
                    <span class="visually-hidden">
                      {runner.repository} {runner.job}: reserves {size(runner.size * GIB)}, p95 peak {size(runner.p95)}
                    </span>
                    <span class="pack-size" aria-hidden="true">
                      {size(runner.size * GIB)}
                    </span>
                    <span class="pack-job" aria-hidden="true">
                      {runner.kind} {runner.name}
                    </span>
                  </li>
                ))}
                <li class="block mirror" style={`--size: ${mirror}`}>
                  <span class="visually-hidden">mirror, 512M</span>
                </li>
                <li class="free" style={`--size: ${pack.free}`}>
                  <span class="visually-hidden">{size(pack.free * GIB)} free</span>
                </li>
              </ul>
            </>
          ))
        }
        <div class="tile pack-table ink">
          <pre class="terminal wide" tabindex="0" role="region" aria-label="runnerd simulate output"><code><span class="prompt">$ {replay.command} | grep -E '^(POLICY|caps|measured)'</span>
{simulateHead}
{simulateRows.join('\n')}
<mark>{simulateMeasured}</mark></code></pre>
        </div>
        <div class="tile pack-note base end">
          <p>
            A synthetic 28-day history, replayed: the bars are its busiest burst, each block what its runner reserves,
            shaded to its job's p95 peak. Measured's longest wait is the longer one: until a job has 10 runs, or after it
            runs out of memory, it <a href={`${base}admission/#measured-admission`}>reserves more</a>.
          </p>
          <a class="text-link" href={`${base}admission/`}>Admission and sizing</a>
        </div>
      </section>

      <section class="board part" id="isolation" aria-labelledby="iso-title">
        <div class="tile iso-text pink">
          <h2 id="iso-title">A new container per job</h2>
          <p class="statement">
            Sysbox gives each runner its own Docker Engine, so a job builds images without <code>--privileged</code>.
          </p>
        </div>
        <ol class="tile iso-steps base" aria-label="A job's way through runnerd">
          {lifecycle.map((step) => (
            <li class={step.name === 'removed' ? 'last' : undefined}>
              <strong>{step.name}</strong>
              <span>{step.what}</span>
            </li>
          ))}
        </ol>
        <div class="tile iso-config ink">
          <pre class="terminal"><code><span class="prompt"># runnerd.toml</span>
{isolationToml}</code></pre>
        </div>
        <div class="tile iso-refuse ink">
          <pre class="terminal"><code>{refuse.split('\n')[0]}
<span class="fail">{refuse.split('\n')[1]}</span></code></pre>
        </div>
        <div class="tile iso-warn base">
          <p class="statement">Serve private repositories only. On a public one, anyone who opens a pull request can run code on this host.</p>
        </div>
      </section>

      <section class="board part" id="sizing" aria-labelledby="size-title">
        <div class="tile size-text mint">
          <h2 id="size-title">It sizes itself</h2>
          <p class="statement">From each job's measured peaks. It writes the change into your config and keeps your comments.</p>
        </div>
        <div class="tile size-out ink">
          <pre class="terminal" tabindex="0" role="region" aria-label="runnerctl sizing output"><code><span class="prompt">$ runnerctl sizing | grep -A4 ^node</span>
{sizing}
<span class="advice">{sizingAdvice}</span></code></pre>
        </div>
        <div class="tile size-conf">
          <pre class="terminal"><code><span class="prompt"># runnerd.toml</span>
{autoToml}</code></pre>
        </div>
        <div class="tile size-note base">
          <p>
            Lowering waits an hour and moves by at most a step; a run that meets the lowered cap takes it back. <code>runnerctl sizing undo node</code> writes the old values.
          </p>
        </div>
      </section>

      <section class="board part" id="records" aria-labelledby="rec-title">
        <div class="tile rec-text pink">
          <h2 id="rec-title">Open a shell in the job that failed</h2>
          <div class="rec-conf">
            <pre class="terminal"><code>{recordToml}</code></pre>
          </div>
        </div>
        <div class="tile rec-shell ink">
          <pre class="terminal" tabindex="0" role="region" aria-label="runnerctl shell output"><code>{shell}</code></pre>
        </div>
        <div class="tile rec-list base">
          <p>The failed job's runner is kept as an image until you remove it. <code>runnerctl records</code> lists them.</p>
          <a class="text-link" href={`${base}running/#records-of-failed-jobs`}>Records of failed jobs</a>
        </div>
      </section>

      <section class="board part" id="cost" aria-labelledby="cost-title">
        <div class="tile cost-fig mint">
          <h2 id="cost-title">What the minutes would have cost</h2>
          <span class="stat">$13.10</span>
        </div>
        <div class="tile cost-out ink">
          <pre class="terminal" tabindex="0" role="region" aria-label="runnerctl insights output"><code><span class="prompt">$ runnerctl insights | head -4</span>
{costHead}
{costRows}</code></pre>
        </div>
      </section>

      <section class="board part" id="pools" aria-labelledby="pools-title">
        <div class="tile pools-head">
          <h2 id="pools-title">Linters don't wait behind builds</h2>
          <p>
            E2E jobs queue for 7G node slots while the small pool's 1G runner waits for the next light job. It leaves out
            <code>self-hosted</code>, so no heavy job lands on it.
          </p>
          <a class="text-link" href={`${base}configuration/#split-light-and-heavy-jobs`}>Split light and heavy jobs</a>
        </div>
        <div class="tile pools-config">
          <div class="tile ink">
            <pre class="terminal"><code><span class="prompt"># runnerd.toml</span>
[[repositories]]
name = "halyard/storefront"
profile = "node"
labels = ["self-hosted", "linux", "x64", "node"]

<mark>[[repositories]]
name = "halyard/storefront"
profile = "small"
labels = ["storefront-small"]</mark></code></pre>
          </div>
          <div class="tile ink">
            <pre class="terminal"><code><span class="prompt"># .github/workflows/ci.yml</span>
  typecheck:
    runs-on: storefront-small</code></pre>
          </div>
        </div>
        <div class="tile pools-status ink">
          <pre class="terminal wide" tabindex="0" role="region" aria-label="runnerctl status output"><code><span class="prompt">$ runnerctl status | sed -n '/^REPOSITORY/,$p'</span>
{pools}</code></pre>
        </div>
        <p class="band">Every wait says why, and what to do</p>
        <ul class="waits">
          <li>
            <code>No profile serves the label storefornt-small</code>
            <p>A typo in <code>runs-on</code>: fix the workflow.</p>
          </li>
          <li>
            <code>The host is short of memory: needs 6G; the host has 2G to spare; programs outside CI hold 30G, most java 9.3G and qemu-system-x86 5.8G</code>
            <p>Your desktop holds it. Close the emulator; running jobs are never stopped.</p>
          </li>
          <li>
            <code>All 2 node slots are busy</code>
            <p><code>runnerctl sizing</code> says whether more fit, and auto sizing adds them.</p>
          </li>
        </ul>
      </section>

      <section class="board part" id="clients" aria-labelledby="clients-title">
        <div class="tile cl-tui">
          <h2 id="clients-title" class="visually-hidden">Watch it from anywhere</h2>
          <Tui
            name="overview-96"
            label="The overview at 96 by 26: a health line with 2 of 6 slots running, 5 jobs waiting and 3 insights, the budget bar reserved by predicted peaks, one line per slot with warm runners in jvm 2 and small 1, the five waiting jobs with why each waits: CI / lint because no profile serves storefornt-small, a runner starting for the next and every node slot busy for the rest, then the repositories, storefront on node + small, and the latest jobs."
          />
        </div>
        <div class="tile cl-job">
          <Shot
            name="job"
            alt="halyard/ledger's CI / build job, running: waited 4s for a runner, 5s to start, nine steps on one time axis with the seventh, integration tests, running; then memory against reserved 7.75G and cap 9G, CPU against reserved 3.6 CPUs and cap 8 CPUs, and how admission reserved them."
            sizes="(min-width: 1100px) 40vw, calc(100vw - 2rem)"
          />
        </div>
        <div class="tile cl-cli ink">
          <pre class="terminal" tabindex="0" role="region" aria-label="runnerctl job and sizing output"><code><span class="prompt">$ runnerctl job 120055991700 | head -5</span>
{jobHead}</code></pre>
        </div>
        <div class="tile cl-phone-text pink">
          <h3><a href={`${clientsDoc}#from-another-device`}>Phone</a></h3>
          <p>Scan the code and the phone stays signed in for 30 days after its last visit.</p>
          <pre class="terminal"><code><span class="prompt">$ runnerctl web --qr</span></code></pre>
        </div>
        <div class="tile cl-phone">
          <a
            class="shot"
            href={phoneShot.src.src}
            data-zoom
            data-zoom-light={phoneShot.light.src}
            data-zoom-width={phoneShot.src.width}
            data-zoom-height={phoneShot.src.height}
          >
            <picture>
              {
                phoneShot.sources.map((source) => (
                  <source
                    type={source.type}
                    srcset={source.srcset}
                    sizes="(max-width: 640px) 45vw, 20vw"
                    media={source.theme === 'light' ? 'not all' : undefined}
                    data-light={source.theme === 'light' ? '' : undefined}
                  />
                ))
              }
              <img
                src={phoneShot.fallback.src}
                alt="The dashboard's overview on a phone: four tiles, 2 of 6 slots running with 1 runner starting and 2 warm, 5 waiting, a p95 wait of 29s and 3 failed in 24 hours, then the waiting jobs, the oldest because no profile serves its label storefornt-small."
                width={phoneShot.src.width}
                height={phoneShot.src.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
        </div>
        <div class="tile cl-ins">
          <Shot
            name="insights"
            alt="Insights: three warnings from the last 14 days, a job that got slower, one near its cap and one flaky, and a notice that waits grew; under them each repository's waits this week against the week before."
            sizes="(min-width: 1100px) 50vw, calc(100vw - 2rem)"
          />
        </div>
        <div class="tile cl-hist-text mint">
          <p class="statement">Every job is kept: its steps, its log, and its CPU and memory every 2 seconds.</p>
          <a class="text-link" href={`${base}running/#job-history`}>Job history</a>
        </div>
        <div class="tile cl-hist">
          <Shot
            name="history"
            alt="History over the last 30 days: 861 jobs, 90% succeeded, 9m 07s average run, 18s average wait, charts of jobs per day, run and wait times and memory peaks."
            sizes="(min-width: 1100px) 58vw, calc(100vw - 2rem)"
          />
        </div>
      </section>

      <section class="board part" id="install" aria-labelledby="install-title">
        <div class="tile start-head accent">
          <h2 id="install-title">Running in four steps</h2>
        </div>
        <div class="tile step-text mint">
          <h3>Install</h3>
          <p>The installer checks the SHA-256 of <code>runnerd</code> and <code>runnerctl</code> and puts them in <code>~/.local/bin</code>. No sudo.</p>
        </div>
        <div class="tile step-shows">
          <div class="command">
            <pre><code>{install}</code></pre>
            <button class="copy" type="button" data-copy={install} hidden>Copy</button>
          </div>
          <div class="terminal-tile"><pre class="terminal lines"><code><span class="prompt"># or from crates.io</span>{cargo.map((line) => <span>{line}</span>)}</code></pre></div>
        </div>
        <div class="tile step-text pink">
          <h3>Write the config</h3>
          <p><code>init</code> writes a config sized for the host and a user unit, runs the doctor, and prints the root steps it needs. It runs none of them.</p>
        </div>
        <div class="tile step-shows">
          <div class="terminal-tile"><pre class="terminal transcript"><code><span class="prompt">$ {init}</span>
{initWrote}

runnerd doctor:
<span class="prompt"><span aria-hidden="true">⋮</span><span class="visually-hidden">four checks that pass</span></span>
<span class="fail">{initFail}</span></code></pre></div>
          <div class="command">
            <pre class="lines"><code>{start.map((line) => <span>{line}</span>)}</code></pre>
            <button class="copy" type="button" data-copy={start.join('\n')} hidden>Copy</button>
          </div>
        </div>
        <div class="tile step-text mint">
          <h3>Point a job at it</h3>
          <p><code>init</code> prints the line. Jobs that ask for other labels, such as <code>ubuntu-latest</code>, stay on GitHub's runners.</p>
        </div>
        <div class="tile step-shows">
          <div class="command">
            <pre><code>{runsOn}</code></pre>
            <button class="copy" type="button" data-copy={runsOn} hidden>Copy</button>
          </div>
        </div>
        <div class="tile step-text pink">
          <h3>Watch it run</h3>
          <p>The next job starts in a fresh container on this machine.</p>
        </div>
        <div class="tile step-shows">
          <div class="command">
            <pre><code>runnerctl tui</code></pre>
            <button class="copy" type="button" data-copy="runnerctl tui" hidden>Copy</button>
          </div>
        </div>
      </section>
    </main>

    <footer class="board footer">
      <div class="tile mark-large bare" aria-hidden="true">
        {['r', 'u', 'n', 'n', 'e', 'r', 'd'].map((letter, i) => <span style={`--i: ${i}`}>{letter}</span>)}
      </div>
      <nav class="tile foot-links" aria-label="Footer">
        <a href={docs}>Install</a>
        <a href={`${docs}#first-run`}>First run</a>
        <a href={`${docs}#verify-a-release`}>Verify a release</a>
        <a href={`${base}configuration/`}>Configuration</a>
        <a href={`${base}running/`}>Running</a>
        <a href={`${base}running/#the-service`}>The service</a>
        <a href={repo}>Source</a>
        <a href={`${repo}/releases`}>Releases</a>
      </nav>
      <div class="tile foot-note">
        <p>
          runnerd {version}. MIT licensed. Linux hosts and GitHub repositories, for now. Terminal frames in JetBrains
          Mono (<a href={`${base}fonts/JetBrainsMono-OFL.txt`}>OFL</a>).
        </p>
      </div>
    </footer>

    <script>
      import { setup } from '../scripts/landing';
      import '../scripts/zoom';
      setup();
    </script>
  </body>
</html>
